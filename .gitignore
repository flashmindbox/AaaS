# Dependencies
node_modules/
.pnpm-store/
.yarn/
.npm/

# Build output
dist/
build/
out/
.next/
.nuxt/
.turbo/
.cache/
*.tsbuildinfo
*.log

# Keep the built widget tracked — it's the file the gateway actually
# serves, and fresh clones should have a working demo before running
# the bundle build.
!apps/widget/dist/
!apps/widget/dist/widget.js

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/
playwright/.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/

# Docker persistent volumes
infra/volumes/
infra/.data/

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~

# Claude Code local state (developer-local)
.claude/

# Generated PDFs (keep source PDF only)
WHAT_WE_ARE_BUILDING.pdf
PLAN.pdf

# Generated diagnostic report (produced by DIAGNOSE.bat on demand)
diagnose-report.txt

# Artifacts / SBOMs
sbom.json
sbom.xml
*.spdx.json

# Browser-extension on-device mode build products — fetched from HF Hub
# and npm by scripts/build_extension_{models,vendor}.py. Not committed
# because they're ~200 MB of ONNX weights + WASM binaries.
apps/extension/models/
apps/extension/vendor/

# Service model weights — downloaded from HF Hub on first service start
# and by services/*/bundle/prefetch_model.py. Multi-GB, regenerable,
# never committed.
services/*/models/
services/**/models/

# Model weight blobs anywhere (safety net for the rules above)
*.safetensors
*.gguf
pytorch_model.bin
