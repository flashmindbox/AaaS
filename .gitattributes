# Normalize line endings to LF across platforms
* text=auto eol=lf

# Explicit text
*.ts  text eol=lf
*.tsx text eol=lf
*.js  text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.py text eol=lf
*.go text eol=lf
*.sh text eol=lf

# Windows batch files need CRLF — cmd.exe `call :label` resolution is
# unreliable in LF-only files (labels intermittently "not found").
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.onnx binary
*.bin binary
*.wav binary
*.mp3 binary
*.ogg binary

# Lockfiles — mark as generated so diffs fold in code review
pnpm-lock.yaml linguist-generated
poetry.lock     linguist-generated
