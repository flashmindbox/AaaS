# AaaS Cloud Demo — environment overrides for docker-compose.
#
# Copy to `.env` at the repo root and tweak. Every variable has a
# reasonable default in docker-compose.yml, so you only need to set
# the ones you want to override.

# ---- Deploy target ------------------------------------------------
# Set to your public domain for automatic HTTPS; leave as "localhost"
# for local dev on plain HTTP. Caddy reads this at startup.
# AAAS_DOMAIN=demo.aaas.cloud
AAAS_DOMAIN=localhost

# Public ports. Use 8080/8443 if you don't want Caddy to try to
# bind the privileged 80/443 on your laptop.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# ---- Runtime env --------------------------------------------------
# "dev" enables looser config (e.g. in-memory tenant repo seeded at
# boot). Use "prod" once you wire Postgres + Keycloak.
AAAS_ENV=dev
LOG_LEVEL=INFO

# ---- STT engine selection ----------------------------------------
# Default is "mock" — curated Odia/Hindi/English transcripts,
# zero-model. Flip to real engines at rebuild time:
#
#   STT_ENGINE_EXTRA=indic   STT_ENGINE=indic_wav2vec
#   STT_ENGINE_EXTRA=whisper STT_ENGINE=whisper
#
# First boot will pull 150–500 MB of weights into the named volume.
# STT_ENGINE_EXTRA=
# STT_ENGINE=mock

# ---- Translate engine selection ----------------------------------
# Same shape as STT. `indic` pulls AI4Bharat IndicTrans2 (~1 GB).
# TRANSLATE_ENGINE_EXTRA=
# TRANSLATE_ENGINE=mock
