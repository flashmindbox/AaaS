[Unit]
Description=AaaS translate service
After=network-online.target
Wants=network-online.target

[Service]
User=aaas
Group=aaas
WorkingDirectory=/opt/aaas/system/services/translate
Environment=HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONIOENCODING=utf-8 PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 OMP_THREAD_LIMIT=4 OMP_WAIT_POLICY=PASSIVE TOKENIZERS_PARALLELISM=false
Environment=AAAS_TRANSLATE_TESSERACT_CMD=/usr/bin/tesseract AAAS_TRANSLATE_TESSDATA_DIR=/opt/aaas/system/services/translate/models/tessdata
ExecStart=/opt/aaas/system/services/translate/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8003  --no-access-log
Restart=always
RestartSec=5
TimeoutStartSec=300
MemoryMax=8G

[Install]
WantedBy=multi-user.target
