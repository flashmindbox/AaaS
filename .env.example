# ---------- General ----------
NODE_ENV=development
LOG_LEVEL=debug

# ---------- Postgres ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aaas
POSTGRES_USER=aaas
POSTGRES_PASSWORD=change-me-in-dev

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- MinIO (S3) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=aaas-dev
S3_SECRET_KEY=aaas-dev-secret
S3_BUCKET_AUDIO=aaas-audio
S3_BUCKET_DOCS=aaas-docs

# ---------- Keycloak ----------
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=aaas
KEYCLOAK_CLIENT_ID=aaas-gateway
KEYCLOAK_CLIENT_SECRET=change-me-in-dev

# ---------- Gateway ----------
GATEWAY_PORT=8000
GATEWAY_PUBLIC_URL=http://localhost:8000

# ---------- AI services ----------
STT_MODEL_PATH=/models/ai4bharat-indicwav2vec-odia
TTS_MODEL_PATH=/models/facebook-mms-tts   # Meta MMS-TTS is the sole TTS engine (or/hi/en)
MT_MODEL_PATH=/models/indictrans2

# ---------- Observability ----------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAMESPACE=aaas
