# AaaS STT service env — copy to .env for local dev.
#
# Engine selection. Defaults to the real AI4Bharat model so a fresh
# ``pip install -e .[indic]`` + ``uvicorn app.main:app`` gets you real
# transcripts, not canned ones. Without ``[indic]`` installed the
# lifespan catches the ImportError and falls back to mock.
#
#   AAAS_STT_ENGINE=indic_wav2vec  (default; needs .[indic], ~1 GB)
#   AAAS_STT_ENGINE=whisper        (pip install -e .[whisper], ~250 MB)
#   AAAS_STT_ENGINE=mock           (explicit opt-out — bundle + CI use this)
AAAS_STT_ENGINE=indic_wav2vec

AAAS_STT_STT_PORT=8002
AAAS_STT_LOG_LEVEL=INFO
AAAS_STT_MODEL_CACHE_DIR=./models
AAAS_STT_MAX_AUDIO_SECONDS=30
