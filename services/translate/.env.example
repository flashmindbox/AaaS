# AaaS Translation service env — copy to .env for local dev.
# SETUP-FRIEND.bat copies this file to .env verbatim on a fresh
# machine, so the engine chosen here is what the demo actually runs.
#
# Defaults to AI4Bharat IndicTrans2 (distilled 200M, en<->indic).
# Its weights ship inside the demo bundle under ./models, so a fresh
# laptop needs no download and no HuggingFace login at run time.
# (The HF repos are "auto"-gated: downloading them fresh needs any
# logged-in HF account — ENSURE-READY.bat handles that, or falls back
# to the google engine.) If the ``[indic]`` extras aren't installed
# the lifespan fails loudly (503 from /readyz) instead of silently
# swapping to mock.
#
#   AAAS_TRANSLATE_ENGINE=indictrans2   (default; .[indic] + bundled ~2 GB weights)
#   AAAS_TRANSLATE_ENGINE=google        (no models; free Google web endpoint,
#                                        needs internet; offline -> mock corpus)
#   AAAS_TRANSLATE_ENGINE=nllb          (.[indic] + ~2.4 GB NLLB weights,
#                                        NOT bundled — download separately)
#   AAAS_TRANSLATE_ENGINE=mock          (explicit opt-out — bundle + CI use this)
AAAS_TRANSLATE_ENGINE=indictrans2

AAAS_TRANSLATE_TRANSLATE_PORT=8003
AAAS_TRANSLATE_LOG_LEVEL=INFO
AAAS_TRANSLATE_MODEL_CACHE_DIR=./models
AAAS_TRANSLATE_MAX_INPUT_CHARS=2000
