# AaaS Translation service env — copy to .env for local dev.
#
# Defaults to Meta NLLB-200 distilled-600M. It handles 200 languages
# (including Odia/Hindi/English) and — unlike AI4Bharat IndicTrans2 —
# it isn't gated on HuggingFace, so ``bundle/prefetch_model.py`` works
# from a clean clone without a HF login. If the ``[indic]`` extras
# aren't installed the lifespan now fails loudly (503 from /readyz)
# instead of silently swapping to mock.
#
#   AAAS_TRANSLATE_ENGINE=nllb          (default; .[indic] + ~2.4 GB weights)
#   AAAS_TRANSLATE_ENGINE=indictrans2   (optional; gated on HF, needs
#                                        `huggingface-cli login` + access)
#   AAAS_TRANSLATE_ENGINE=mock          (explicit opt-out — bundle + CI use this)
AAAS_TRANSLATE_ENGINE=nllb

AAAS_TRANSLATE_TRANSLATE_PORT=8003
AAAS_TRANSLATE_LOG_LEVEL=INFO
AAAS_TRANSLATE_MODEL_CACHE_DIR=./models
AAAS_TRANSLATE_MAX_INPUT_CHARS=2000
