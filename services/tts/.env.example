# AaaS TTS service — env template. Copy to `.env` and tweak locally.

AAAS_ENV=dev
LOG_LEVEL=INFO
TTS_PORT=8001

# Legacy single-model override. At runtime this is treated as the
# checkpoint for DEFAULT_LANGUAGE (Odia by default). Most deployments
# should leave LANGUAGE_MODELS as the source of truth and only set this
# to swap the default-language model without touching Hindi/English.
MODEL_ID=facebook/mms-tts-ory

# Where transformers caches downloaded weights. When the bundle ships,
# point this at the bundled directory so first-run works offline.
MODEL_CACHE_DIR=./models

# ISO-639-1 → HF model id map, JSON-encoded. The service eager-loads
# DEFAULT_LANGUAGE and lazy-loads the others on first request.
# Uncomment and edit to disable a language you don't want to ship.
# LANGUAGE_MODELS={"or":"facebook/mms-tts-ory","hi":"facebook/mms-tts-hin","en":"facebook/mms-tts-eng"}

# Language used when /synthesise is called without a `lang` field.
DEFAULT_LANGUAGE=or

# Max characters accepted per request. VITS chokes on very long inputs
# and users should chunk anyway — we hard-cap to keep latency predictable.
MAX_INPUT_CHARS=600

# Output sample rate. All three MMS-TTS checkpoints run at 16000 Hz;
# keep it here unless we add a resampler.
SAMPLE_RATE=16000
