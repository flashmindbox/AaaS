# AaaS gateway — dev config.
# Copy to .env; never commit .env (see repo .gitignore).

AAAS_ENV=dev
LOG_LEVEL=INFO

# Port the gateway listens on.
GATEWAY_PORT=8000

# Upstream service URLs (dev docker-compose hostnames).
# In production these come from the service-mesh / k8s DNS.
UPSTREAM_TTS_URL=http://localhost:8001
UPSTREAM_STT_URL=http://localhost:8002
UPSTREAM_ADMIN_URL=http://localhost:8003

# Postgres (tenant + API-key lookup, audit log).
DATABASE_URL=postgresql://aaas:change-me-in-dev@localhost:5432/aaas

# Redis (rate limits, TTS cache).
REDIS_URL=redis://localhost:6379/0

# Keycloak OIDC.
OIDC_ISSUER=http://localhost:8080/realms/aaas
OIDC_AUDIENCE=aaas-gateway
OIDC_JWKS_URL=http://localhost:8080/realms/aaas/protocol/openid-connect/certs

# Rate-limit defaults (overridable per-tenant in Postgres).
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
