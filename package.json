{
  "name": "aaas-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Accessibility as a Service (AaaS) — a centralized, cloud-based accessibility infrastructure for public institutions in India.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/subarnarekha/aaas",
  "repository": {
    "type": "git",
    "url": "https://github.com/subarnarekha/aaas"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "typecheck": "turbo run typecheck",
    "a11y": "turbo run a11y",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "prepare": "echo 'skip husky for now'"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.11.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  }
}
